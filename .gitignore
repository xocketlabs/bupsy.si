# Swift / SPM
.build/
.swiftpm/
*.xcodeproj
*.xcworkspace
DerivedData/
Package.resolved
# Except BupsyKit's: it is the lockfile. Without it every build resolved GRDB afresh, so CI, a
# release and a laptop could each compile a different version, and a compromised upstream release
# would reach us with no commit to review. CI builds with --force-resolved-versions, and
# Dependabot proposes changes to this file like any other.
!Packages/BupsyKit/Package.resolved

# macOS
.DS_Store

# Spike artefacts — captured from a real account, never committed.
# Sanitised fixtures live in Packages/BupsyKit/Tests/BupsyKitTests/Fixtures/ instead.
# (docs/screenshots/ IS committed — the README needs it.)
docs/samples/*.ndjson
docs/samples/*-flags.txt

# Signing and secrets. Nothing here should ever exist, but fail safe.
*.p12
*.mobileprovision
.env

# XcodeGen output — regenerate with `xcodegen generate` (or `make app`)
Bupsy.xcodeproj/

# Packaging and local CI output (scripts/package.sh, scripts/ci-local.sh)
build/

# Local wrangler state
.wrangler/

# Demo videos (scripts/record-demo.sh)
demo-out/

# Claude Code worktrees and local settings
.claude/
