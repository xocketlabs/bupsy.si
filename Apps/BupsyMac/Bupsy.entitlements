<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The microphone, for talking to a bot instead of typing. The hardened runtime blocks it
	     without this, and macOS still asks the person before Bupsy may listen. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
